{
  "name": "tts-oc",
  "version": "2.0.0",
  "description": "OpenCode plugin with on-demand response speech controls",
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./tui": "./dist/tui.js"
  },
  "files": [
    "dist",
    "tui.js",
    "package.json"
  ],
  "scripts": {
    "build": "node build.mjs",
    "prepare": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.mjs"
  },
  "keywords": [
    "opencode",
    "plugin",
    "tts",
    "text-to-speech",
    "summary"
  ],
  "license": "MIT",
  "dependencies": {
    "@opencode/plugin": "^2.1.2",
    "esbuild": "^0.25.2"
  },
  "peerDependencies": {
    "@opentui/core": ">=0.6.6",
    "@opentui/solid": ">=0.6.6",
    "solid-js": ">=1.9.0"
  },
  "peerDependenciesMeta": {
    "@opentui/core": { "optional": true },
    "@opentui/solid": { "optional": true },
    "solid-js": { "optional": true }
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-typescript": "^7.27.1",
    "@types/node": "^22.13.9",
    "babel-plugin-module-resolver": "5.0.2",
    "babel-preset-solid": "1.9.12",
    "typescript": "^5.8.2"
  }
}
